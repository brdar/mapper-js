{
    "name": "automapper-nestjs",
    "version": "0.0.0",
    "type": "module",
    "main": "./index.cjs",
    "module": "./index.js",
    "types": "./src/index.d.ts",
    "peerDependencies": {
        "automapper-core": "latest",
        "@nestjs/common": "^7.0.0 || ^8.0.0 || ^9.0.0 || ^10.0.0 || ^11.0.0",
        "@nestjs/core": "^7.0.0 || ^8.0.0 || ^9.0.0 || ^10.0.0 || ^11.0.0"
    },
    "exports": {
        ".": {
            "types": "./src/index.d.ts",
            "import": {
                "types": "./src/index.d.ts",
                "default": "./index.js"
            },
            "require": {
                "types": "./src/index.d.ts",
                "default": "./index.cjs"
            },
            "default": "./index.js"
        }
    },
    "sideEffects": false,
    "engines": {
        "node": ">=16.0.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/brdar/mapper-js/tree/main/packages/nestjs"
    },
    "author": {
        "name": "Chau Tran",
        "email": "nartc7789@gmail.com",
        "url": "https://nartc.me"
    },
    "description": "AutoMapper TypeScript NestJS integration",
    "keywords": [
        "typescript",
        "automapper",
        "mapper",
        "nestjs",
        "nx"
    ],
    "license": "MIT",
    "files": [
        "**/*"
    ]
}
